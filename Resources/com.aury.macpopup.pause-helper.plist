<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The pause helper (Sources/PauseHelper): started by launchd when MacPopup connects, and again if it crashes (so it
     continues what it stopped). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aury.macpopup.pause-helper</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/pause-helper</string>
    <key>MachServices</key>
    <dict>
        <key>com.aury.macpopup.pause-helper</key>
        <true/>
    </dict>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.aury.macpopup</string>
    </array>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
